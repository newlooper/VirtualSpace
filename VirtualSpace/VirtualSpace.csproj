<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <StartupObject>VirtualSpace.Program</StartupObject>
        <UseWindowsForms>True</UseWindowsForms>
        <ApplicationIcon>Resources\Logo_2.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Platforms>AnyCPU;x64;x86</Platforms>
        <LangVersion>9</LangVersion>
        <CsWinRTEnabled>false</CsWinRTEnabled>
    </PropertyGroup>

    <PropertyGroup>
        <OverwriteReadOnlyOutputFiles>true</OverwriteReadOnlyOutputFiles>
        <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory).build\AutoVersion.props" />
    <Import Project="$(MSBuildThisFileDirectory).build\EmbeddedVDLib.props" />

    <ItemGroup>
        <ApplicationDefinition Remove="App.xaml" />
        <Page Include="App.xaml" />
    </ItemGroup>

    <PropertyGroup>
        <NoWarn>1701;1702;CA1416;CS8618</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WPF\ControlPanel\ControlPanel.csproj" />
        <ProjectReference Include="..\Plugins.sln\Cube3D\Cube3D.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
            <GlobalPropertiesToRemove>TargetFramework;RuntimeIdentifier;SelfContained</GlobalPropertiesToRemove>
            <SetTargetFramework>TargetFramework=$(TfmNet10WindowsSdk22000)</SetTargetFramework>
            <ExcludeAssets>all</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>

    <Target Name="CopyPluginsToPublishDir" AfterTargets="Publish">
        <PropertyGroup>
            <_HostPluginsDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\Plugins\</_HostPluginsDir>
        </PropertyGroup>
        <ItemGroup>
            <_HostPluginFiles Include="$(_HostPluginsDir)**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(_HostPluginFiles)"
              DestinationFolder="$(PublishDir)Plugins\%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition="'@(_HostPluginFiles)' != ''" />
        <Message Text="Copied host plugins to $(PublishDir)Plugins"
                 Importance="high"
                 Condition="'@(_HostPluginFiles)' != ''" />
    </Target>

    <Target Name="DeletePdb" AfterTargets="Publish">
        <ItemGroup>
            <FileToDelete Include="bin\**\*.pdb" />
        </ItemGroup>
        <Delete Files="@(FileToDelete)" />
        <Message Text="Deleted files: '@(FileToDelete)'" Importance="high" />
    </Target>

    <PropertyGroup>
        <SatelliteResourceLanguages>en-US,zh-Hans,zh-Hant</SatelliteResourceLanguages>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory).build\EmbeddedVDLib.targets" />

</Project>
