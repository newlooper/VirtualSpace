<Project>
    <!--
      Assemblies that ship with the host (ControlPanel) and are shared via
      PluginLoadContext → Default ALC. Keep them out of plugin OutDir / Plugins\$(MSBuildProjectName)
      so Debug and Publish both verify host borrowing (same idea as
      VirtualSpace/.build/EmbeddedVDLib.targets excluding VirtualDesktop* from publish).
    -->
    <ItemGroup>
        <HostSharedAssembly Include="MaterialDesignThemes.Wpf" />
        <HostSharedAssembly Include="MaterialDesignColors" />
        <HostSharedAssembly Include="Microsoft.Xaml.Behaviors" />
        <HostSharedAssembly Include="WPFLocalizeExtension" />
        <HostSharedAssembly Include="XAMLMarkupExtensions" />
    </ItemGroup>

    <Target Name="RemoveHostSharedAssembliesFromOutput" AfterTargets="CopyFilesToOutputDirectory">
        <PropertyGroup>
            <_PluginOutDir>$([MSBuild]::EnsureTrailingSlash('$(OutDir)'))</_PluginOutDir>
        </PropertyGroup>
        <ItemGroup>
            <_HostSharedOut Include="$(_PluginOutDir)%(HostSharedAssembly.Identity).dll" />
            <_HostSharedOut Include="$(_PluginOutDir)%(HostSharedAssembly.Identity).pdb" />
        </ItemGroup>
        <Delete Files="@(_HostSharedOut)" TreatErrorsAsWarnings="true" />
        <Message Text="$(MSBuildProjectName): stripped host-shared deps from OutDir (must resolve from host): @(HostSharedAssembly)"
                 Importance="high" />
    </Target>

    <Target Name="ExcludeHostSharedAssembliesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                                   Condition="'%(Filename)' == 'MaterialDesignThemes.Wpf'
                                              Or '%(Filename)' == 'MaterialDesignColors'
                                              Or '%(Filename)' == 'Microsoft.Xaml.Behaviors'
                                              Or '%(Filename)' == 'WPFLocalizeExtension'
                                              Or '%(Filename)' == 'XAMLMarkupExtensions'" />
        </ItemGroup>
    </Target>
</Project>
