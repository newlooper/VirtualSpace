<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>$(TfmNet10WindowsSdk22000)</TargetFramework>
        <LangVersion>9</LangVersion>
        <UseWPF>true</UseWPF>
        <CsWinRTEnabled>false</CsWinRTEnabled>
        <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

    <PropertyGroup>
        <OverwriteReadOnlyOutputFiles>true</OverwriteReadOnlyOutputFiles>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory).build\AutoVersion.props" />
    <Import Project="$(MSBuildThisFileDirectory).build\ExcludeHostSharedDeps.targets" />

    <ItemGroup>
        <Compile Remove="Properties\**" />
        <EmbeddedResource Remove="Properties\**" />
        <None Remove="Properties\**" />
        <Page Remove="Properties\**" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\Helpers\WinMsg.cs" Link="Helpers\WinMsg.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- Compile against host MD; runtime comes from Default ALC (see ExcludeHostSharedDeps.targets). -->
        <PackageReference Include="MaterialDesignThemes" Version="5.3.2" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Plugin\PluginContracts\PluginContracts.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
        <ProjectReference Include="..\ScreenCapture\ScreenCapture.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Helpers\" />
    </ItemGroup>

    <!-- Runs after host-shared deps are stripped from OutDir so Debug Plugins\Cube3D never contains them. -->
    <Target Name="CopyToHostPlugins" AfterTargets="RemoveHostSharedAssembliesFromOutput">
        <PropertyGroup>
            <_HostOutDir>$(MSBuildThisFileDirectory)..\..\VirtualSpace\bin\$(Configuration)\$(TfmNet10Windows)\</_HostOutDir>
            <_PluginDest>$(_HostOutDir)Plugins\Cube3D\</_PluginDest>
            <_CopyFrom>$([MSBuild]::EnsureTrailingSlash('$(OutDir)'))</_CopyFrom>
        </PropertyGroup>
        <ItemGroup>
            <_PluginFiles Include="$(_CopyFrom)*.*"
                          Exclude="$(_CopyFrom)*.pdb;$(_CopyFrom)*.deps.json;$(_CopyFrom)MaterialDesign*.dll;$(_CopyFrom)Microsoft.Xaml.Behaviors.dll" />
            <_StaleShared Include="$(_PluginDest)%(Cube3DHostSharedAssembly.Identity).dll" />
        </ItemGroup>
        <MakeDir Directories="$(_PluginDest)" />
        <Delete Files="@(_StaleShared)" TreatErrorsAsWarnings="true" />
        <Copy SourceFiles="@(_PluginFiles)" DestinationFolder="$(_PluginDest)" SkipUnchangedFiles="true" />
        <Message Text="Copied Cube3D plugin to $(_PluginDest) (host-shared deps excluded: @(Cube3DHostSharedAssembly))"
                 Importance="high" />
    </Target>

</Project>
