<Window x:Class="Cube3D.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:cvt="clr-namespace:VirtualSpace.Helpers"
        xmlns:localConfig="clr-namespace:Cube3D.Config"
        mc:Ignorable="d"
        lex:LocalizeDictionary.OutputMissingKeys="True"
        Title="{lex:Loc VirtualSpace.PluginContracts:Langs:Cube3D.Settings.WindowTitle}"
        Height="520" Width="900"
        Topmost="True"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="Segoe UI,Segoe UI Emoji,Segoe UI Symbol,Microsoft YaHei UI,Microsoft YaHei">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme colors come from Application.Resources (ControlPanel UpdateTheme). -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <cvt:TransitionTypeConverter x:Key="Ttc" />
            <Style TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignGroupBox}">
                <Setter Property="Margin" Value="10" />
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Foreground="{DynamicResource MaterialDesignBody}"
                                       Text="{Binding}"
                                       FontWeight="Bold"
                                       FontSize="16" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignPaperSecondaryLightButton}">
                <Setter Property="Margin" Value="10,5" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="100" />
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
                <Setter Property="Margin" Value="10,5,0,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="200" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="{lex:Loc VirtualSpace.PluginContracts:Langs:Cube3D.Settings.Basic}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{lex:Loc VirtualSpace.PluginContracts:Langs:Cube3D.Settings.AnimationDuration}" />
                            <Slider x:Name="SliderAnimationDuration"
                                    Width="300"
                                    Margin="10,8,0,0"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True"
                                    Minimum="{Binding Source={x:Static localConfig:Const.AnimationDurationMin}}"
                                    Maximum="{Binding Source={x:Static localConfig:Const.AnimationDurationMax}}"
                                    Value="{Binding AnimationDuration}"
                                    TickFrequency="10"
                                    TickPlacement="None"
                                    LargeChange="10" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       MinWidth="40"
                                       Text="{Binding ElementName=SliderAnimationDuration, Path=Value}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{lex:Loc VirtualSpace.PluginContracts:Langs:Cube3D.Settings.AnimationType}" />
                            <ComboBox Width="160" x:Name="ComboBoxEffects" SelectionChanged="ComboBoxEffects_SelectionChanged" />
                            <Button Content="{lex:Loc VirtualSpace.PluginContracts:Langs:Cube3D.Settings.Apply}" Click="ApplyEffect_OnClick" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{lex:Loc VirtualSpace.PluginContracts:Langs:Cube3D.Settings.EaseType}" />
                            <ComboBox Width="160" x:Name="ComboBoxEase" SelectionChanged="ComboBoxEase_OnSelectionChanged" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{lex:Loc VirtualSpace.PluginContracts:Langs:Cube3D.Settings.EaseMode}" />
                            <ComboBox Width="160" x:Name="ComboBoxEaseMode" SelectionChanged="ComboBoxEaseMode_OnSelectionChanged" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{lex:Loc VirtualSpace.PluginContracts:Langs:Cube3D.Settings.TransitionType}" />
                            <ComboBox Width="280" x:Name="ComboBoxTransitionType" SelectionChanged="ComboBoxTransitionType_OnSelectionChanged" />
                            <CheckBox x:Name="CbNgOnAllScreens"
                                      Content="{lex:Loc VirtualSpace.PluginContracts:Langs:Cube3D.Settings.ShowNgOnAllScreens}"
                                      Checked="CbNgOnAllScreens_OnChecked"
                                      Unchecked="CbNgOnAllScreens_OnUnchecked"
                                      IsEnabled="{Binding ElementName=ComboBoxTransitionType,
                                                          Path=SelectedItem,
                                                          Converter={StaticResource Ttc}}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,4,10,10">
            <Button Content="{lex:Loc VirtualSpace.PluginContracts:Langs:Cube3D.Settings.Close}" Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
