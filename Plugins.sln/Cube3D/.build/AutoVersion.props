<Project>
    <!-- Override with /p:AppVersion=1.0.1706.101 — do not pass /p:Version= (global, stamps ProjectReferences). -->
    <PropertyGroup>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <VS_Product>Cube3D</VS_Product>
        <VS_Description>VirtualSpace.Plugin - Cube3D</VS_Description>
        <VS_Company>https://github.com/newlooper</VS_Company>
        <VS_Major Condition="'$(VS_Major)' == ''">1</VS_Major>
        <VS_Minor Condition="'$(VS_Minor)' == ''">0</VS_Minor>
    </PropertyGroup>

    <PropertyGroup Condition="'$(AppVersion)' == ''">
        <VS_DaysSinceStart>$([System.DateTime]::UtcNow.Subtract($([System.DateTime]::new(2022, 2, 28))).Days)</VS_DaysSinceStart>
        <VS_MinutesSinceMidnight>$([MSBuild]::Add($([MSBuild]::Multiply($([System.DateTime]::UtcNow.Hour), 60)), $([System.DateTime]::UtcNow.Minute)))</VS_MinutesSinceMidnight>
        <AppVersion>$(VS_Major).$(VS_Minor).$(VS_DaysSinceStart).$(VS_MinutesSinceMidnight)</AppVersion>
    </PropertyGroup>

    <PropertyGroup>
        <Version>$(AppVersion)</Version>
        <AssemblyVersion>$(AppVersion)</AssemblyVersion>
        <FileVersion>$(AppVersion)</FileVersion>
        <InformationalVersion>$(AppVersion)</InformationalVersion>
        <Product>$(VS_Product)</Product>
        <AssemblyTitle>$(VS_Description)</AssemblyTitle>
        <Description>$(VS_Description)</Description>
        <Company>$(VS_Company)</Company>
        <Copyright>Copyright © 2022 - $([System.DateTime]::Now.Year)</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="AutoVersion.cs" />
    </ItemGroup>

    <Target Name="LogAppVersion" BeforeTargets="BeforeBuild">
        <Message Text="Cube3D AppVersion=$(AppVersion)" Importance="High" />
    </Target>
</Project>
