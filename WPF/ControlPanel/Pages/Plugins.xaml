<UserControl x:Class="ControlPanel.Pages.Plugins"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:commons="clr-namespace:ControlPanel.Pages.Menus.Commons"
             xmlns:converters="clr-namespace:ControlPanel.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:LocConverter x:Key="LocConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style TargetType="ScrollViewer">
                <Setter Property="Margin" Value="5" />
            </Style>
            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                <Setter Property="Padding" Value="5,5" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignPaperSecondaryLightButton}">
                <Setter Property="Margin" Value="0,5,20,5" />
                <Setter Property="Height" Value="30" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <commons:MenuContainer x:Name="MenuContainer" />
        </Grid>
        <Grid Grid.Row="1" x:Name="PluginsContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,20,0">
                <!-- Fully-qualified keys: ListView/GridView break the visual tree used by DefaultAssembly. -->
                <Button Content="{lex:Loc ControlPanel:Langs:Page.Plugins.Refresh}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
            <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="10,10,10,12">
                <ListView x:Name="PluginsList" ItemsSource="{Binding Plugins}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsLoaded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120" DisplayMemberBinding="{Binding Name}">
                                <GridViewColumnHeader Content="{lex:Loc ControlPanel:Langs:Page.Plugins.Name}" />
                            </GridViewColumn>
                            <GridViewColumn Width="100" DisplayMemberBinding="{Binding Version}">
                                <GridViewColumnHeader Content="{lex:Loc ControlPanel:Langs:Page.Plugins.Version}" />
                            </GridViewColumn>
                            <GridViewColumn x:Name="PluginDescriptionColumn" Width="200">
                                <GridViewColumnHeader Content="{lex:Loc ControlPanel:Langs:Page.Plugins.Description}" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="{Binding Width, Source={x:Reference PluginDescriptionColumn}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120" DisplayMemberBinding="{Binding Author}">
                                <GridViewColumnHeader Content="{lex:Loc ControlPanel:Langs:Page.Plugins.Author}" />
                            </GridViewColumn>
                            <GridViewColumn Width="100">
                                <GridViewColumnHeader Content="{lex:Loc ControlPanel:Langs:Page.Plugins.Status}" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextAlignment="Center"
                                                   Text="{lex:Loc {Binding LoadStatus, Mode=OneWay,
                                                          Converter={StaticResource LocConverter},
                                                          ConverterParameter=ControlPanel:Langs:Page.Plugins.Status.}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="260">
                                <GridViewColumnHeader Content="{lex:Loc ControlPanel:Langs:Page.Plugins.Operations}" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{lex:Loc ControlPanel:Langs:Page.Plugins.Settings}"
                                                    Command="{Binding SettingsCommand}" />
                                            <Button Content="{lex:Loc ControlPanel:Langs:Page.Plugins.Restart}"
                                                    Command="{Binding RestartCommand}" />
                                            <Button Content="{lex:Loc ControlPanel:Langs:Page.Plugins.Close}"
                                                    Command="{Binding CloseCommand}"
                                                    Visibility="{Binding ShowCloseButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
